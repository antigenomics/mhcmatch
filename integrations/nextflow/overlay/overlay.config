// Configuration for the mhcmatch overlay. ONE line in your config, or one `-c` on the command line:
//
//     includeConfig '<path>/integrations/nextflow/overlay/overlay.config'
//
// **It pulls in the module's own config itself**, on the line below, so there is no second include
// to forget. Forgetting it used to be a real trap and a bad one: every `params.mhcmatch_*` would be
// undefined, undefined is falsy, and `mhcmatch_vector_screen` therefore read as OFF -- a cassette
// built with no safety screen, reported as one WARN among a dozen. `overlay.nf` still refuses to run
// when the params are missing, because a caller can always include this file the wrong way, but the
// ordinary path can no longer get it wrong.
// A RELATIVE path, resolved against this file rather than against the entry script.
// `${projectDir}` is the entry script's directory, not the config's, so under `-c` it pointed
// somewhere else entirely and the config would not parse at all.
includeConfig '../mhcmatch/nextflow.config'

// ---------------------------------------------------------------------------------------------
// LEVEL 0: the zero-touch deployment. `nextflow run . -c overlay.config`, no file in your
// repository edited, no `include` added. It repairs the %rank threshold and points every
// mhcmatch-invoking process at a pinned image, which is worth doing on its own.
//
// **It does NOT choose the predictor for you.** A host pipeline that has an mhcmatch branch selects
// it with its own predictor switch, under whatever name that pipeline gives it, and one class may
// already default to mhcmatch while the other does not. A config file cannot reach inside a host's
// `if`.
// ---------------------------------------------------------------------------------------------

// **A single `--rank-threshold` number cannot be class-aware.** NetMHCpan calls class I strong at
// 0.5 and weak at 2.0; NetMHCIIpan calls class II strong at 2.0 and weak at 10.0. So a host default
// of 2.0 is the weak cut for class I and the STRONG cut for class II -- measured on one window pair
// against DRB1*15:01, 0 of 56 scored pairs survive it and the best window is discarded at %rank
// 2.364. Applied to class I alone it merely drops candidates a later aggregation could still have
// ranked. Either way `none` is the right value at the predictor: filter where you can see what you
// filtered.
params.mhcmatch_rank_threshold = params.mhcmatch_rank_threshold ?: 'none'

// **A `withName` selector matches the ALIAS, not the file's process name.** A host that writes
// `include { MHCMATCH_PREDICT as MHCMATCH_MHCI }` -- the ordinary way to serve two classes from one
// process -- is matched by `MHCMATCH_MHCI`, and a selector naming `MHCMATCH_PREDICT` binds to
// nothing at all and reports no error. So the default is deliberately broad: it sets `container` and
// `conda` and NOTHING else, and pinning the image on a process that does not call mhcmatch costs
// nothing. Narrow it to your own alias names if you would rather be explicit.
//
// The `publishDir` selector below is the opposite case and is enumerated, because relocating a file
// is not free.
//
// **A `withName` selector must be a literal**, so this is not a param: Nextflow 26's config parser
// rejects `withName: "${...}"` outright with `Unexpected input: '"'`, and the whole config then
// fails to parse -- taking every mode down, not just level 0. To bind different names, add your own
// `withName` block in your config; process directives compose.

// ---------------------------------------------------------------------------------------------
// LEVEL 1-3: the modes. `off` schedules nothing but the preflight, which is what makes the
// `include` safe to merge before anyone has decided anything.
// ---------------------------------------------------------------------------------------------
params.mhcmatch_overlay_mode = params.mhcmatch_overlay_mode ?: 'off'

// ---------------------------------------------------------------------------------------------
// `rerank` mode: what MHCMATCH_RESCORE reads, what it writes, and what it carries through.
//
// **These are declared here, not left to the `?:` fallbacks in rescore.nf.** A `params.foo` that
// nobody set is null and usable, but Nextflow prints `WARN: Access to undefined parameter` for each
// one -- nine warnings on every run of a mode that is working correctly, which reads as a broken
// integration. Declaring them also puts the defaults where a host can see and override them.
//
// The four base weights and the two driver boosts are the HOST's, and `?:` means a host that loads
// its own config in the same session keeps its own values -- these only fill in for a standalone run.
// ---------------------------------------------------------------------------------------------
params.mhcmatch_overlay_score_column   = params.mhcmatch_overlay_score_column   ?: 'score'
params.mhcmatch_overlay_rescore_column = params.mhcmatch_overlay_rescore_column ?: null
params.mhcmatch_overlay_keep_weights   = params.mhcmatch_overlay_keep_weights   ?:
    'hla_weight,recurrence_weight,hla_frequency_weight'
params.weight_affinity          = params.weight_affinity          ?: 4.0
params.weight_agretopicity      = params.weight_agretopicity      ?: 1.0
params.weight_expr_gene         = params.weight_expr_gene         ?: 2.0
params.weight_expr_local        = params.weight_expr_local        ?: 0.0
params.driver_boost_driver      = params.driver_boost_driver      ?: 1.0
params.driver_boost_likely_driver = params.driver_boost_likely_driver ?: 1.0

// The release the overlay was written against. The processes call CLI flags BY NAME, so a mismatch
// fails inside a fan-out task log with `unrecognized arguments` and `mhcmatch --version` cannot warn
// you, because both releases print a string. Preflight asserts it once, in seconds. Set to '' to
// skip the check.
params.mhcmatch_overlay_require_version = params.mhcmatch_overlay_require_version ?: '1.20.0'

process {
    // ---- level 0: pin the image every mhcmatch call runs in, with no script edit -------------
    // A host that already calls mhcmatch pins its own image, and that pin goes stale silently: the
    // one measured here still named 1.0.1. This binds the host's processes and ours to one release.
    withName: '.*MHCMATCH_[A-Z0-9_]*$' {
        container = params.mhcmatch_container
        // **No `conda` here, and there is no spelling of it that would work.** A config file has
        // no `moduleDir` -- Nextflow 26 does not leave it null, it fails config parsing outright
        // with "`moduleDir` is not defined", taking every mode down -- and `projectDir` is the
        // ENTRY script's directory, not this file's, so it named `<host repo>/../mhcmatch/` when
        // included from a host and `overlay/test/../mhcmatch/` under the stub harness. Neither
        // exists. A relative `includeConfig` is resolved against the including file and is the one
        // config-relative mechanism there is; it does not extend to a directive's value.
        //
        // Nothing is lost by dropping it: every process this selector can reach already declares
        // its own `conda "${moduleDir}/environment.yml"` -- nine in ../mhcmatch/main.nf, plus
        // preflight.nf and rescore.nf here -- in `.nf` files, where `moduleDir` IS defined and
        // resolves against the file that wrote it. A host wanting conda on its own aliased
        // processes sets it in its own config; process directives compose.
    }

    // ---- preflight: cheap, and first ---------------------------------------------------------
    withName: '.*MHCMATCH_PREFLIGHT$' {
        cpus   = 1
        memory = 2.GB
        time   = 10.m
        // It must not be silently retried into success -- if the version is wrong it stays wrong.
        errorStrategy = 'terminate'
        publishDir = [ path: { "${params.outdir}/mhcmatch" }, mode: params.publish_dir_mode ]
    }

    // ---- the asymmetry that matters ----------------------------------------------------------
    // **Annotation-only work must not be able to fail a cohort**, and the cassette path must not be
    // able to fail SILENTLY. Under `ignore` a failed upstream process empties its channel, and every
    // process downstream of an empty channel is skipped WITHOUT error -- so `ignore` on the cassette
    // path would produce a run that reports success and builds nothing. The two need opposite
    // strategies and the reason is not symmetric.
    withName: '.*(MHCMATCH_NEOAG|MHCMATCH_MIMICRY)$' {
        errorStrategy = 'ignore'
    }
    // MHCMATCH_RESCORE is on the cassette side of this line even though no cassette is built in
    // `rerank` mode: it writes the table the host's own selector consumes, so a failure that is
    // ignored hands the selector the unreranked table and the run reports success.
    withName: '.*(MHCMATCH_CASSETTE|MHCMATCH_CASSETTE_SELECT|MHCMATCH_CASSETTE_SCORE|MHCMATCH_RESCORE)$' {
        errorStrategy = 'terminate'
    }

    // Everything the overlay publishes goes under one directory of its own, so nothing it writes
    // can land on top of a file the host pipeline owns.
    //
    // **Enumerated, not `.*MHCMATCH_.*`.** That pattern also matches a host pipeline's own
    // mhcmatch-named processes and silently RELOCATES their published outputs -- one measured host
    // publishes its class-II tables from an `MHCMATCH_`-prefixed process of its own into
    // `${params.outdir}/epitopes`, and a catch-all selector moved that deliverable out from under
    // its own operators. An overlay that advertises additive-only output may not move a host's
    // files.
    withName: '.*(MHCMATCH_PREFLIGHT|MHCMATCH_RESCORE|MHCMATCH_RERANK|MHCMATCH_RANK|MHCMATCH_NEOAG|MHCMATCH_MIMICRY|MHCMATCH_ALLELES|MHCMATCH_CASSETTE|MHCMATCH_CASSETTE_SELECT|MHCMATCH_CASSETTE_SCORE)$' {
        publishDir = [ path: { "${params.outdir}/mhcmatch" },
                       mode: params.publish_dir_mode,
                       saveAs: { it.equals('versions.yml') ? null : it } ]
    }
}
