// The overlay's config. Load BOTH lines from your pipeline's config, in this order:
//
//     includeConfig '<path>/integrations/nextflow/mhcmatch/nextflow.config'
//     includeConfig '<path>/integrations/nextflow/overlay/overlay.config'
//
// The first is included from here too, so one `-c overlay.config` on the command line is enough for
// a run that has no config of its own -- but a pipeline WITH one should name both, because
// `includeConfig` resolves relative to this file and a copied path is a path to maintain.
includeConfig '../mhcmatch/nextflow.config'

// **`--rank-threshold none`, deliberately.** Filtering at the predictor throws away candidates the
// later aggregation could still have ranked, and 2.0 is the WEAK class-I cut and the STRONG
// class-II one -- measured on one window pair against DRB1*15:01, 0 of 56 scored pairs survive it.
// Filter where you can see what was filtered.
params.mhcmatch_rank_threshold = params.mhcmatch_rank_threshold ?: 'none'

// off | annotate | rerank | denovo | cassette -- see overlay.nf. `off` is the default, which is
// what makes this safe to merge before anyone has decided anything.
params.mhcmatch_overlay_mode = params.mhcmatch_overlay_mode ?: 'off'

// ---- rerank mode: the one place a host's construct changes because of this model ---------------
//
// Every host-specific name is a parameter with a default, so the overlay carries no knowledge of
// any particular pipeline.
params.mhcmatch_overlay_score_column   = params.mhcmatch_overlay_score_column   ?: 'score'
params.mhcmatch_overlay_rescore_column = params.mhcmatch_overlay_rescore_column ?: null
// The multiplicative corrections carried through untouched. They are CLINICAL and this model does
// not contain them: a driver boost of 100.0 and an HLA-loss weight of 0.0 for an allele the tumour
// has lost are both ordinary settings, and replacing the product would put an epitope restricted to
// a deleted allele back into a construct.
params.mhcmatch_overlay_keep_weights   = params.mhcmatch_overlay_keep_weights   ?:
    'hla_weight,recurrence_weight,hla_frequency_weight'
// The host's own base weights and driver boosts, read from ITS params when they are loaded in the
// same session. `params.foo` on a key nobody set is null, so these are what a standalone run gets.
params.weight_affinity            = params.weight_affinity            ?: 4.0
params.weight_agretopicity        = params.weight_agretopicity        ?: 1.0
params.weight_expr_gene           = params.weight_expr_gene           ?: 2.0
params.weight_expr_local          = params.weight_expr_local          ?: 0.0
params.driver_boost_driver        = params.driver_boost_driver        ?: 1.0
params.driver_boost_likely_driver = params.driver_boost_likely_driver ?: 1.0

// **The release the overlay was written against.** The processes call CLI flags BY NAME, so an
// older install exits 2 on an unknown flag deep in a task log -- it has happened: PyPI served the
// previous release while the module had gained `--map-binder`, and both cassette tasks died with
// `unrecognized arguments`. MHCMATCH_PREFLIGHT compares this to `mhcmatch --version` before any
// work starts. Set it to null to skip the check.
params.mhcmatch_overlay_require_version = params.mhcmatch_overlay_require_version ?: '1.20.1'

process {
    // `container` and `publishDir` for MHCMATCH_* come from ../mhcmatch/nextflow.config's one
    // selector, which is anchored loosely enough to cover MHCMATCH_PREFLIGHT and MHCMATCH_RESCORE
    // too. Only what is specific to the overlay is set here.

    // The preflight computes nothing and exists to refuse to start, so a failure here must stop the
    // run rather than be retried or ignored.
    withName: '.*MHCMATCH_PREFLIGHT$' {
        cpus   = 1
        memory = 2.GB
        time   = 10.m
        errorStrategy = 'terminate'
    }

    // **Annotation may fail; a deliverable may not.** `neoag` and `mimicry` add columns beside the
    // score and change no ordering, so losing one costs annotation. Everything that writes a
    // construct, a selection or a rewritten score column terminates instead -- a cassette that
    // silently did not get built is the failure this overlay exists to avoid.
    withName: '.*MHCMATCH_(NEOAG|MIMICRY)$' {
        errorStrategy = 'ignore'
    }
    withName: '.*MHCMATCH_(CASSETTE|CASSETTE_SELECT|CASSETTE_SCORE|RESCORE)$' {
        errorStrategy = 'terminate'
    }
}
