// Per-process config for the mhcmatch module. `includeConfig` this from your pipeline's config
// (e.g. workflows/neoantigens/nextflow.config), mirroring how the other predictor modules are wired.
//
// Species follows `params.genome` -- the iGenomes assembly key nf-core sets from `--genome` -- so
// mhcmatch follows the assembly the rest of the pipeline already runs on, exactly as the ARDA module
// does, with no extra parameter to configure:
//   GRCm39 -> --species mouse      anything else (GRCh38, ...) -> --species human

def mhcmatchSpecies = { params.genome == 'GRCm39' ? '--species mouse' : '--species human' }

process {
    withName: 'MHCMATCH_PREDICT|MHCMATCH_RANK|MHCMATCH_NEOAG|MHCMATCH_MIMICRY|MHCMATCH_VECTOR' {
        // Append any extra flags for that command here; they land after the module's own.
        ext.args = mhcmatchSpecies
        publishDir = [
            path: { "${params.outdir}/mhcmatch" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // The cassette screen builds one whole-proteome index per register length: ~12 GB peak each and
    // a few minutes apiece, four register lengths for class I. Give it its own resources rather than
    // inheriting `process_high`'s defaults, which are not sized for that.
    withName: 'MHCMATCH_VECTOR' {
        memory = { params.mhcmatch_vector_screen ? 48.GB * task.attempt : 8.GB * task.attempt }
        time   = { params.mhcmatch_vector_screen ? 8.h  * task.attempt : 1.h  * task.attempt }
    }
}

// ---------------------------------------------------------------- params, with defaults

// Reference panel tier and the %rank cutoff below which `predict` emits a row.
params.mhcmatch_tier             = 'full'
params.mhcmatch_rank_threshold   = 2.0

// `rank`: 'fasta' (variant windows) or 'table' (an already-scored table).
params.mhcmatch_rank_mode        = 'fasta'
// TCGA study code for tumour-matched expression. `mhcmatch expression --list-contexts` prints the
// 19 TCGA<->GTEx pairings. Leaving it null falls back to the cross-tissue median, which answers
// "is this gene expressed anywhere" rather than "is it expressed in this tumour" -- set it.
params.mhcmatch_tumor            = null
// Append the six signed mimicry channels / the nearest-reference and known-neoantigen annotations.
// Neither changes the ordering: they are reported beside `score`, never folded into it.
// `aggregate` (default) scores with the fitted BOECRT model; `gate` is the pre-0.19.0
// product-of-sigmoids, kept so a run can be compared against an earlier ordering.
params.mhcmatch_rank_score       = 'aggregate'
params.mhcmatch_rank_extended    = false
params.mhcmatch_rank_annotate    = false

// `neoag` search radius. Fuzzy beats exact: held out, matching at <=2 substitutions roughly doubles
// to triples the recall of a fresh cohort's true positives over exact lookup.
params.mhcmatch_neoag_max_subs   = 2

params.mhcmatch_mimicry_annotate = false

// `vector`. n0 is per-allotype capacity and REQUIRED with no default, matching the library: nothing
// in the public record fits it, so the value is yours to defend and it is recorded in the output.
params.mhcmatch_vector_n0        = null
// WITHOUT THIS NO SAFETY CHECK RUNS AT ALL and the cassette carries whatever it was handed.
params.mhcmatch_vector_screen    = true

// The cassette map (since v0.16.0): unit / linker / epitope rows in 1-based coordinates over the
// cassette, emitted as TSV + JSON so a viewer can draw it without recomputing anything. Cheap --
// it re-scores the assembled cassette, which is one short sequence.
params.mhcmatch_vector_map           = true
params.mhcmatch_vector_map_threshold = 2.0
// The recipient's class-II allotypes. Without them the map is class I only and `self_help` --
// whether a unit's CD8 epitope has CD4 help from the SAME unit -- is not computed.
params.mhcmatch_vector_map_alleles_mhc2 = null
