// Per-process config for the mhcmatch module. `includeConfig` this from your pipeline's config
// (e.g. workflows/neoantigens/nextflow.config), mirroring how the other predictor modules are wired.
//
// Species follows `params.genome` -- the iGenomes assembly key nf-core sets from `--genome` -- so
// mhcmatch follows the assembly the rest of the pipeline already runs on, exactly as the ARDA module
// does, with no extra parameter to configure:
//   GRCm39 -> --species mouse      anything else (GRCh38, ...) -> --species human

// ---------------------------------------------------------------- params this module READS but does not OWN
//
// `outdir`, `publish_dir_mode` and `genome` belong to the calling pipeline -- every nf-core pipeline
// defines them -- and this module only consumes them. They are defaulted here **only when absent**,
// never unconditionally: a plain assignment would silently override a pipeline that had chosen
// `symlink`, and this file is documented as being included *after* the pipeline's own config.
//
// Without a default the module cannot run standalone at all: `publishDir mode:` is the one of the
// three evaluated eagerly at config-parse time (the other two sit inside closures and resolve per
// task, after the script's own `params` have been set), so an unset `publish_dir_mode` aborts the
// run before the first process. Measured on Aldan-3 2026-08-23, Nextflow 21.10.6:
//
//   Unknown config attribute `process.withName:MHCMATCH_*.params.publish_dir_mode`
//
// **`x = x ?: default` is the portable spelling, and the obvious `if (!params.containsKey(...))` is
// not.** Nextflow's config DSL was tightened in 25.x: 26.04.6 rejects the guarded form outright
// ("If statements cannot be mixed with config statements") while every version accepts a plain
// assignment. Reading the param first is what keeps it from clobbering a caller who set it -- a bare
// `params.publish_dir_mode = 'copy'` would silently override a pipeline that had chosen `symlink`,
// because this file is documented as being included *after* the pipeline's own config.
params.outdir           = params.outdir           ?: 'results'
params.publish_dir_mode = params.publish_dir_mode ?: 'copy'
params.genome           = params.genome           ?: 'GRCh38'
// One tag for every process. `main.nf` used to repeat the literal in every `container` directive,
// which is why it sat three releases behind the library it runs: bumping meant finding fourteen
// copies across four files. Read the param first, so a caller who set it is not clobbered.
params.mhcmatch_container = params.mhcmatch_container ?: 'mhcmatch:1.7.2'

// **`-profile slurm` is defined HERE, not in slurm.config.** Nextflow auto-loads the
// `nextflow.config` sitting beside the script it runs, so this is the file `nextflow run
// pipeline.nf` actually reads -- and a profile can only be *selected* from a config that is
// loaded. slurm.config documents how a CALLING pipeline wires the same include into its own
// `profiles` block; that comment is for integrators and does nothing for someone running
// pipeline.nf directly. Without this block `-profile slurm` aborts at startup with
// "Unknown configuration profile: slurm", which is what templates/run_slurm_head.sbatch did.
profiles {
    slurm {
        includeConfig 'slurm.config'
    }
}

// **Every selector below is anchored loosely on purpose.** `subworkflows/denovo.nf` includes the
// shared tail under a `_DN` alias, because a DSL2 process may be invoked once per run and running
// both arms would otherwise raise "Process 'X' has been already used". A selector written as the
// exact name would then match the rerank arm's processes and silently miss the de novo arm's --
// which for MHCMATCH_CASSETTE means 8 GB instead of 48 and an OOM kill hours in.
process {
    withName: '.*MHCMATCH_(ALLELES|PREDICT|RANK|RERANK|NEOAG|MIMICRY|CASSETTE|CASSETTE_SELECT|CASSETTE_SCORE).*' {
        container = params.mhcmatch_container
        publishDir = [
            path: { "${params.outdir}/mhcmatch" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // **The species flag goes to the commands that accept it, and no further.** `mhcmatch alleles`,
    // `neoag`, `mimicry` and `cassette select` have no `--species`: they pick their references from
    // `--cls` and the fitted per-host tables, or read no panel at all. Handing it to all of them --
    // which this file did from the day the neoag/mimicry processes were added -- makes each exit 2
    // with `unrecognized arguments: --species` on every real run, and the stub does not catch it
    // because a stub runs no command. Measured on Aldan-3 2026-08-23, Nextflow 26.04.6: PREDICT and
    // RANK completed, MIMICRY failed. `RERANK` **is** in the list, because it is `rank pairs`.
    //
    // Inlined rather than held in a `def mhcmatchSpecies = {...}` above: Nextflow 26.04.6 rejects a
    // variable declaration in a config file outright ("Variable declarations cannot be mixed with
    // config statements"), so the named-closure form -- which this file used from 0.16.0 to 0.27.0
    // -- made the module unparseable on any current Nextflow. A closure as the VALUE of a config
    // setting is still fine; only the `def` binding is not. Append your own extra flags here.
    withName: '.*MHCMATCH_(PREDICT|RANK|RERANK|CASSETTE)(_DN)?$' {
        ext.args = { params.genome == 'GRCm39' ? '--species mouse' : '--species human' }
    }

    // **The two arms name their outputs apart, and they must.** Both run NEOAG, MIMICRY,
    // CASSETTE_SELECT and CASSETTE, and every one of those writes `${prefix}.<something>` with
    // `prefix = meta.id`. Under `--mode both` that is the SAME filename from two processes: the de
    // novo cassette overwrites the rerank one in publishDir, and -- worse, because it is silent --
    // `CASSETTE_SCORE` collecting `*.vaccine.units.tsv` gets a set that mixes the two, so a unit
    // chosen from one arm's pool is scored against the other's. Measured on a mouse line: 5 of 20
    // units were absent from the pool they were supposedly selected from.
    //
    // The rerank arm carries the plain process name and the de novo arm the `_DN` include alias, so
    // one selector each. A caller who includes a process directly gets neither and keeps the bare
    // `meta.id`, which is the behaviour that was there before.
    // Qualified by ARM, not just by process name: `subworkflows/mhcmatch.nf` runs the same
    // processes under the same names and must keep its own output filenames, so a selector written
    // as `.*MHCMATCH_NEOAG$` would rename its files too.
    withName: '.*MHCMATCH_RERANK_ARM:MHCMATCH_(NEOAG|MIMICRY|CASSETTE|CASSETTE_SELECT)$' {
        ext.prefix = { "${meta.id}.rerank" }
    }
    withName: '.*MHCMATCH_DENOVO_ARM:MHCMATCH_(NEOAG|MIMICRY|CASSETTE|CASSETTE_SELECT)_DN$' {
        ext.prefix = { "${meta.id}.denovo" }
    }
    // Cohort-level, so no `meta` to key on -- but the same collision, since both arms write one
    // file with a fixed name into one publishDir.
    withName: '.*MHCMATCH_RERANK_ARM:MHCMATCH_CASSETTE_SCORE$'    { ext.prefix = 'cohort.rerank' }
    withName: '.*MHCMATCH_DENOVO_ARM:MHCMATCH_CASSETTE_SCORE_DN$' { ext.prefix = 'cohort.denovo' }

    // **Both arms ORDER, they do not re-select.** MHCMATCH_CASSETTE_SELECT has already chosen
    // exactly `--mhcmatch_cassette_k` units; `cassette build` would size them again under `--n0`
    // and throw most away -- measured on a real donor as `-k 20` in and a two-unit, 54 aa cassette
    // out. `subworkflows/mhcmatch.nf` has no selector and keeps `build`, where the `--n0` rule is
    // the answer to "how many units" rather than a second one.
    withName: '.*MHCMATCH_RERANK_ARM:MHCMATCH_CASSETTE$'     { ext.verb = 'order' }
    withName: '.*MHCMATCH_DENOVO_ARM:MHCMATCH_CASSETTE_DN$'  { ext.verb = 'order' }

    // Which column the cohort scorer reads, per arm. The rerank arm's POOL is the caller's own
    // table and has a `score` column of theirs, so an unqualified fallback would score the cassette
    // on ours and the pool on theirs. `cassette select` writes its own resolved value under plain
    // `score`, so the units half falls back correctly and says which column it used.
    withName: '.*MHCMATCH_RERANK_ARM:MHCMATCH_CASSETTE_SCORE$' {
        ext.score_column = { params.mhcmatch_cassette_score_column
                                 ?: "${params.mhcmatch_rerank_prefix ?: 'mm_'}score" }
    }

    // **Which column holds the aggregate, per arm.** `_cassette_rows` resolves `score` /
    // `aggregate` / `epic` when it is not told, and a pipeline candidate table HAS a `score`
    // column -- the caller's own. On the rerank arm that means selecting on the upstream tool's
    // ranking while believing it selected on ours; it is reported on stderr and is otherwise
    // invisible. The rerank arm carries the plain process name and the de novo arm the `_DN`
    // alias, so the two can be told apart here without a second parameter.
    withName: '.*MHCMATCH_CASSETTE_SELECT$' {
        ext.args = { params.mhcmatch_cassette_score_column ? ''
                     : "--score-column ${params.mhcmatch_rerank_prefix ?: 'mm_'}score" }
    }

    // The cassette screen builds one whole-proteome index per register length: ~12 GB peak each and
    // a few minutes apiece, four register lengths for class I. Give it its own resources rather than
    // inheriting `process_high`'s defaults, which are not sized for that.
    withName: '.*MHCMATCH_CASSETTE(_DN)?$' {
        memory = { "${params.mhcmatch_vector_screen}".toLowerCase() !in ['false', '0', 'no', ''] ? 48.GB * task.attempt : 8.GB * task.attempt }
        time   = { "${params.mhcmatch_vector_screen}".toLowerCase() !in ['false', '0', 'no', ''] ? 8.h  * task.attempt : 1.h  * task.attempt }
    }

    // Named after `MHCMATCH_CASSETTE` and sized nothing like it: one pass over the collected tables.
    // Declared AFTER the block above so it wins whichever way a given Nextflow resolves a selector
    // that is a prefix of another process's name -- 48 GB and an 8 h wall clock for a 20-second job
    // is the kind of request that sits in a cluster queue behind quota for hours.
    withName: '.*MHCMATCH_(ALLELES|CASSETTE_SCORE|CASSETTE_SELECT).*' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 20.m * task.attempt }
    }

    // `rank --score aggregate` computes every one of the model's features before scoring.
    //
    // Through 0.20.0 that meant the self-mimicry reference -- ~7.5 GB peak and 6 min 15 s per task
    // -- because BOECRT scored on `self_tcr`. Since 0.24.0 the corpus term is a k-mer table
    // contraction rather than a neighbour search, so all three channels (`thymus`, `self`, `viral`)
    // together cost three tables of 64 KB and the ranking path builds no trie at all.
    //
    // Since 0.25.0 it does not build the tables either: they ship in the wheel
    // (`data/corpus_tables.npz`, 145.4 kB for all eight class x component x species), so a fan-out
    // no longer pays 115.6 s per task to rebuild what every other task is rebuilding at the same
    // time. A cold `rank --score aggregate` went 69.4 s -> 18.8 s.
    //
    // `--extended`/`--annotate` still load the self reference to say *which* peptide was nearest,
    // and that is what the higher ceiling below is for -- but only at the lengths the task's own
    // candidates have (0.25.0), so a class-II run is 83.1 s rather than ~19 min for all fifteen.
    withName: '.*MHCMATCH_(RANK|RERANK)$' {
        memory = { "${params.mhcmatch_rank_extended}".toLowerCase() !in ['false', '0', 'no', ''] ? 16.GB * task.attempt : 8.GB * task.attempt }
        time   = { "${params.mhcmatch_rank_extended}".toLowerCase() !in ['false', '0', 'no', ''] ? 4.h  * task.attempt : 1.h * task.attempt }
    }
}

// ---------------------------------------------------------------- params, with defaults

// Reference panel tier and the %rank cutoff below which `predict` emits a row.
params.mhcmatch_tier             = 'full'
params.mhcmatch_rank_threshold   = 2.0

// `rank`: 'fasta' (variant windows) or 'table' (an already-scored table).
params.mhcmatch_rank_mode        = 'fasta'
// TCGA study code for tumour-matched expression. `mhcmatch expression --list-contexts` prints the
// 19 TCGA<->GTEx pairings. Leaving it null falls back to the cross-tissue median, which answers
// "is this gene expressed anywhere" rather than "is it expressed in this tumour" -- set it.
params.mhcmatch_tumor            = null
// Append the six signed mimicry channels / the nearest-reference and known-neoantigen annotations.
// Neither changes the ordering: they are reported beside `score`, never folded into it.
// `aggregate` (default) scores with the fitted EPIC model; `gate` is the pre-0.19.0
// product-of-sigmoids, kept so a run can be compared against an earlier ordering.
params.mhcmatch_rank_score       = 'aggregate'
params.mhcmatch_rank_extended    = false
params.mhcmatch_rank_annotate    = false

// The binding core: the NetMHCpan `core`/`Of` pair plus the register behind it. For class I both
// anchors are held and the central bulge gives way (a gap pad at 8-mers); for class II it is the
// register-anchored 9-mer, from the model's per-allele register on `predict`/`rank fasta` and from
// the allele-agnostic one on `neoag`, which `core_source` records per row. Free -- the register is
// already computed where it exists -- reported, and never scored.
params.mhcmatch_predict_core     = false
params.mhcmatch_rank_core        = false
params.mhcmatch_neoag_core       = false

// `neoag` search radius. Fuzzy beats exact: held out, matching at <=2 substitutions roughly doubles
// to triples the recall of a fresh cohort's true positives over exact lookup.
params.mhcmatch_neoag_max_subs   = 2

params.mhcmatch_mimicry_annotate = false

// `vector`. n0 is per-allotype capacity and REQUIRED with no default, matching the library: nothing
// in the public record fits it, so the value is yours to defend and it is recorded in the output.
// The `mhcmatch_vector_*` names are kept although the process is now MHCMATCH_CASSETTE: they are in
// every deployed config we know of, and a parameter rename is a silent failure (an unknown param is
// simply ignored) rather than a loud one.
params.mhcmatch_vector_n0        = null
// WITHOUT THIS NO SAFETY CHECK RUNS AT ALL and the cassette carries whatever it was handed.
params.mhcmatch_vector_screen    = true

// The cassette map (since v0.16.0): unit / linker / epitope rows in 1-based coordinates over the
// cassette, emitted as TSV + JSON so a viewer can draw it without recomputing anything. Cheap --
// it re-scores the assembled cassette, which is one short sequence.
params.mhcmatch_vector_map           = true
// null, not 2.0: an explicit number OVERRIDES the tier below, and a default of 2.0 would pin
// class I forever and make `--mhcmatch_vector_map_binder strong` a half-measure.
params.mhcmatch_vector_map_threshold = null
// Which NetMHCpan cut-off the cassette map annotates: `weak` (class I %rank <= 2.0, class II
// <= 10.0) or `strong` (0.5 / 2.0). The two classes do NOT share a number, and the previous
// single 2.0 was weak for class I and strong for class II.
params.mhcmatch_vector_map_binder = 'weak'
params.mhcmatch_vector_map_threshold_mhc2 = null
// The recipient's class-II allotypes. Without them the map is class I only and `self_help` --
// whether a unit's CD8 epitope has CD4 help from the SAME unit -- is not computed.
// The recipient's class-II allotypes, for the epitope map. Pass it explicitly -- deriving it from
// `pipeline.nf`'s `--alleles_mhc2` was tried and does not work, because that param is not visible
// in the module's scope and the fallback silently produced nothing.
params.mhcmatch_vector_map_alleles_mhc2 = null

// Quota composition (since v0.24.1): fill declared slot budgets so that at least k of each arm is
// expected to respond, instead of taking the ranked top. `ARM=SLOTS:TARGET`, comma-separated, e.g.
// 'mhc1=14:2,mhc2=4:1,nonconventional=2:1'. Arms are disjoint -- a unit whose variant is anything
// but a missense is charged to `nonconventional`, so "at least one non-conventional epitope
// responds" cannot be satisfied for free by the class-I arm. With a quota set, VECTOR emits TWO
// cassettes: the composed one and the same slot budgets filled by score alone, side by side.
// Off by default: the arms and their targets are a trial-design decision with no defensible default.
params.mhcmatch_vector_quota      = null
// P(a block is live) in the response model behind the quota. A block is an allotype: if the
// recipient never mounts a response on it, none of its units respond however good they are. This is
// a CEILING on any unit's own p -- a candidate whose p_response exceeds it makes the marginal
// unrepresentable and the run stops. Measure it on your own readout with
// mhcmatch.portfolio.betabinom_rho before trusting this default.
params.mhcmatch_vector_block_live = 0.5
// Weight on class-I allotype evenness (H/Hmax) in the quota objective; 0 = off. The block model
// already prefers spread where spread helps. Homozygosity is not scored as a design flaw: the
// denominator is the DISTINCT allotypes the recipient has.
params.mhcmatch_vector_evenness   = 0.0

// ---------------------------------------------------------------- params `pipeline.nf` owns
//
// Declared HERE, not in the script: Nextflow 26.x strict syntax rejects a bare statement at script
// level, so `params.indir = null` in pipeline.nf fails to compile with "Statements cannot be mixed
// with script declarations". Read-first (`x = x ?: default`) for the same reason as `outdir` above
// -- a caller who set one on the command line must not be clobbered.
params.indir        = params.indir        ?: null
params.mode         = params.mode         ?: 'both'      // rerank | denovo | both
// Explicit globs, for filenames that do not follow the convention in ./README.md. Each defaults to
// the convention applied under --indir.
params.epitopes     = params.epitopes     ?: null
params.windows      = params.windows      ?: null
params.typing       = params.typing       ?: null
// One literal allele list for EVERY sample, bypassing MHCMATCH_ALLELES. The mouse case, and not a
// shortcut: an inbred line's H-2 haplotype is a property of the line, so there is no typing file to
// read and nothing to infer. Class I and class II are separate because they are separate panels.
params.alleles      = params.alleles      ?: null
params.alleles_mhc2 = params.alleles_mhc2 ?: null

// --- the rerank arm --------------------------------------------------------------------------
// The prefix on the columns MHCMATCH_RERANK adds. The caller's own columns are emitted verbatim and
// under their own names; without a prefix, a table that already has `score`, `allele` or `rank`
// would carry each of them twice.
params.mhcmatch_rerank_prefix = 'mm_'

// --- fixed-size cassette selection -----------------------------------------------------------
// How many units are manufactured. This is a different question from `mhcmatch_vector_n0`, which
// says how many the recipient's allotypes can CARRY: `-k` is a construct-size commitment and n0 is
// a capacity estimate, and MHCMATCH_CASSETTE_SELECT answers the first so MHCMATCH_CASSETTE can lay
// out exactly that many.
params.mhcmatch_cassette_k = 20
// Manufacturing tolerance: the reported size is the one in [k-tol, k+tol] with the largest
// objective. A tolerance that gets spent is a result -- the objective has an internal optimum size
// and it moves with the prevalence and with rho.
params.mhcmatch_cassette_tol = 0
// Which column holds the aggregate log-odds in the pool handed to `select`. On the rerank arm that
// is the prefixed one; left null, `select` resolves `score` / `aggregate` / `epic` and reports
// which it used.
params.mhcmatch_cassette_score_column = null
// The HLA-loss rate `cassette select` prices: below 1, two units on one allotype are lost
// together and the objective charges that covariance. **This is not `mhcmatch_vector_block_live`**,
// which is P(a block is live) in `cassette build --quota`'s response model and defaults to 0.5.
// Same flag name, different question, different default -- and passing the quota's value here
// stops the run, because a unit whose marginal p exceeds q is not representable.
params.mhcmatch_cassette_block_live = 1.0

// The column of a reranked table holding the LONG window a cassette unit is built from.
//
// **Defaulted, and it must be**, because the fallback is not a smaller version of the right thing:
// without it `_read_units` reads `peptide`, which on a reranked table is the MINIMAL epitope, and a
// 9-mer loads onto any cell without costimulation -- the tolerising configuration (PMID 17911588).
// A caller whose table spells the window differently gets a loud `missing column` from
// `_read_units` rather than a silently wrong cassette, which is the right failure of the two.
//
// Consulted ONLY when there is no `--context` FASTA, so the de novo arm and the original
// `subworkflows/mhcmatch.nf` are unaffected -- they rebuild the window from the variant FASTA,
// which is the same object arrived at from the other side. 27 aa is `--unit-length` exactly.
params.mhcmatch_vector_unit_column = params.mhcmatch_vector_unit_column ?: 'epitope_context'

// The pool prevalence `rank`'s `p_response` column is anchored on -- the assumed fraction of THIS
// candidate list that responds. A prior you own, not a model output: the fit gave every screen its
// own intercept precisely so base rate stayed out of the slopes. It shifts every probability and
// moves no rank. Left null, the CLI uses TESLA's 37 of 615 = 0.0602.
params.mhcmatch_prevalence        = null

// --- cassette scoring, across the whole run -----------------------------------------------------
// `MHCMATCH_CASSETTE_SCORE` fits ONE calibration offset over every donor in the run, which is what
// makes two donors' `yield` values comparable. Turning `per_donor_offset` on reports an enrichment
// against each donor's own background instead: still useful, no longer a probability, and no longer
// comparable between donors. Off by default because the cross-donor reading is the one a triage
// needs and the one that is easy to lose without noticing.
params.mhcmatch_cassette_rho               = null
params.mhcmatch_cassette_per_donor_offset  = false

// ---------------------------------------------------------------- the supported Nextflow floor
//
// **22.10 is the floor and it is now stated.** Nothing declared one before, so the first version
// incompatibility surfaced as a corrupt-looking module: Aldan-3 ships 21.10.6 (Dec 2021), whose
// Groovy parser rejects `emit: native` -- `native` is a Java/Groovy reserved word -- and reports it
// as "Unexpected input: '{'" against the enclosing `process {`. The emit is renamed regardless,
// because relying on a parser tolerating a reserved keyword is not a contract; this line is so the
// *next* incompatibility says which version it wants instead of pointing at a brace.
//
// A caller that declares its own, stricter floor should include this config BEFORE its own
// `manifest` block -- config merging is last-wins, and this is the weaker requirement of the two.
manifest {
    nextflowVersion = '>=22.10.0'
}
