// Per-process config for the mhcmatch module. `includeConfig` this from your pipeline's config,
// mirroring how the other predictor modules are wired.
//
// Species follows `params.genome` -- the iGenomes assembly key nf-core sets from `--genome` -- so
// mhcmatch follows the assembly the rest of the pipeline already runs on, with no extra parameter:
//   GRCm39 -> --species mouse      anything else (GRCh38, ...) -> --species human

// ------------------------------------------------- params this module READS but does not OWN
//
// **`x = x ?: default` is the portable spelling, and the obvious `if (!params.containsKey(...))` is
// not.** Nextflow's config DSL was tightened in 25.x: 26.04.6 rejects the guarded form outright
// ("If statements cannot be mixed with config statements") while every version accepts a plain
// assignment. Reading the param first is what keeps it from clobbering a caller who set it -- this
// file is documented as being included AFTER the pipeline's own config.
//
// Without a default the module cannot run standalone at all: `publishDir mode:` is evaluated
// eagerly at config-parse time (the other two sit inside closures and resolve per task), so an
// unset `publish_dir_mode` aborts the run before the first process with
// "Unknown config attribute `process.withName:MHCMATCH_*.params.publish_dir_mode`".
params.outdir           = params.outdir           ?: 'results'
params.publish_dir_mode = params.publish_dir_mode ?: 'copy'
params.genome           = params.genome           ?: 'GRCh38'
// One tag for every process. `main.nf` used to repeat the literal in every `container` directive,
// which is why it sat three releases behind the library it runs.
params.mhcmatch_container = params.mhcmatch_container ?: 'mhcmatch:1.20.0'

// **A profile can only be SELECTED from a config that is loaded.** Nextflow auto-loads the
// `nextflow.config` beside the script it runs, so without a block here `-profile conda` aborts at
// startup with "Unknown configuration profile".
//
// **This module is local-only by design and ships no executor profile.** An executor, a queue name,
// a retry policy and a shared reference directory are properties of one site's scheduler rather than
// of mhcmatch, and they go stale in a way nobody can test from here. The per-process `cpus`/`memory`
// /`time` below are the part that travels, because they are measurements of the work.
profiles {
    conda  { conda.enabled  = true }
    docker { docker.enabled = true }
}

process {
    // Container and publishDir in ONE selector, for every process in the module; `container` was
    // also declared per process in main.nf until 1.21.0, which is two places to bump. `conda`
    // stays in main.nf because it needs `moduleDir`, which a config file has no equivalent of --
    // `projectDir` there is the ENTRY script's directory, not the module's.
    //
    // The selector is anchored loosely so an `include { MHCMATCH_PREDICT as MHCMATCH_MHCI }` in a
    // host pipeline still matches -- the ordinary way to serve two classes from one process, and a
    // selector naming the exact process then binds to nothing and says nothing.
    withName: '.*MHCMATCH_[A-Z0-9_]*$' {
        container = params.mhcmatch_container
        publishDir = [
            path: { "${params.outdir}/mhcmatch" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: '.*MHCMATCH_(PREDICT|RANK|RERANK|CASSETTE)$' {
        ext.args = { params.genome == 'GRCm39' ? '--species mouse' : '--species human' }
    }

    // The cassette screen. Flat since 1.17.0: the 48 GB / 8 h arm sized a screen that built one
    // whole-proteome index PER REGISTER LENGTH at ~12 GB peak, and one `seqtree.TextIndex` now
    // answers every length at 0.8 GB. While the conditional was still here, a local run or
    // `-profile docker` made Nextflow refuse to schedule the task on any machine under 48 GB.
    withName: '.*MHCMATCH_CASSETTE$' {
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    // Named after `MHCMATCH_CASSETTE` and sized nothing like it: one pass over collected tables.
    // Declared AFTER the block above so it wins whichever way a given Nextflow resolves a selector
    // that is a prefix of another process's name -- 48 GB and an 8 h wall clock for a 20-second job
    // is the kind of request that sits in a cluster queue behind quota for hours.
    withName: '.*MHCMATCH_(ALLELES|CASSETTE_SCORE|CASSETTE_SELECT)$' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 20.m * task.attempt }
    }

    // `rank --score aggregate` computes every one of the model's features before scoring. The
    // corpus term is a k-mer table contraction rather than a neighbour search, so all three channels
    // cost three tables of 64 KB and the ranking path builds no trie at all -- and it does not build
    // the tables either, they ship in the wheel (`data/corpus_tables.npz`, 145.4 kB for all eight
    // class x component x species). A cold `rank --score aggregate` costs 18.8 s.
    //
    // `--extended`/`--annotate` DO load the self reference, to say which peptide was nearest, and
    // that is what the higher ceiling is for -- but only at the lengths the task's own candidates
    // have, so a class-II run is 83.1 s rather than ~19 min for all fifteen.
    //
    // Coerced inside the closure, which is evaluated per task: a config statement runs BEFORE
    // Nextflow applies `--param`, so `--mhcmatch_rank_extended false` arrives as the truthy string.
    withName: '.*MHCMATCH_(RANK|RERANK)$' {
        memory = { "${params.mhcmatch_rank_extended}".toLowerCase() in ['false', '0', 'no', '', 'null'] ? 8.GB * task.attempt : 16.GB * task.attempt }
        time   = { "${params.mhcmatch_rank_extended}".toLowerCase() in ['false', '0', 'no', '', 'null'] ? 1.h  * task.attempt : 4.h  * task.attempt }
    }

    // **Sized to fit a machine, not to the worst case, and that is deliberate.** `neoag` queries a
    // seqtree index the WHEEL ships (0.02 s build at release, 1 ms load, 1.45 M queries/s), so it
    // is cheap; `mimicry` builds a whole-proteome reference index and is not, which is one reason
    // it ships off. An earlier 32 GB here made Nextflow refuse to schedule either on any machine
    // with less than that -- including every GitHub runner at 15.6 GB, and every laptop -- which is
    // the same defect this file already records for MHCMATCH_CASSETTE's old 48 GB arm. A request
    // that cannot be met is worse than one that is retried: `task.attempt` is what grows it.
    withName: '.*MHCMATCH_(NEOAG|MIMICRY)$' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
}

// ------------------------------------------------- params, with defaults
//
// Every name below is `mhcmatch_<command>_<flag>`, so the setting read here and the setting read in
// `mhcmatch --help` are the same setting.

// The reference panel tier every scoring command shares. `shortlist` is the fast panel; a run that
// mixes the two scores its candidates against one panel and screens its cassette against another.
params.mhcmatch_tier           = 'full'
// What to DROP at the predictor. `none` by default: filtering happens where you can see what was
// filtered, and 2.0 is the WEAK class-I cut and the STRONG class-II one -- measured on one window
// pair against DRB1*15:01, 0 of 56 scored pairs survive it.
params.mhcmatch_rank_threshold = 'none'

// Two whitelists, because they make different claims about a row. `--keep-genes` says the gene is
// of interest; `--keep-epitopes` says the peptide itself has a validated response, which is
// evidence about the peptide. One flag answering both could not say which it answered, so there
// are two and a `keep_reason` column.
params.mhcmatch_keep_genes     = null
params.mhcmatch_keep_epitopes  = null    // `builtin` loads the shipped seqtree index (~1 ms)
params.mhcmatch_keep_mismatch  = 0       // 0 | 1 -- substitution radius for --keep-epitopes

// The input SHAPE `rank` reads, not the immunological mode: fasta | table | pairs.
params.mhcmatch_rank_mode      = 'fasta'
// The immunological MODE -- which fitted model scores the rows. `rank --epitope`, never `--mode`.
params.mhcmatch_rank_epitope   = 'neoantigen'   // neoantigen | pathogen
// TCGA study code for tumour-matched expression -- SET THIS. Without it, expression is the GTEx
// cross-tissue median, which answers "is this gene expressed anywhere" when the question is "is it
// expressed in this tumour". `mhcmatch expression --list-contexts`. Dropped in pathogen mode,
// where `rank` refuses it.
params.mhcmatch_tumor          = null
params.mhcmatch_rank_score     = 'aggregate'    // aggregate | gate | features
params.mhcmatch_rank_extended  = false          // + the mimicry aggregate and its signed channels
params.mhcmatch_rank_annotate  = false          // + each channel's nearest reference peptide
params.mhcmatch_predict_core   = false
params.mhcmatch_rank_core      = false
params.mhcmatch_neoag_core     = false
params.mhcmatch_neoag_max_subs = 2

// Off by default: an annotation step that costs a whole-proteome index and feeds no ranking.
params.mhcmatch_mimicry          = false
params.mhcmatch_mimicry_annotate = false

// The prefix on the columns the rerank arm adds to the caller's own table.
params.mhcmatch_rerank_prefix  = 'mm_'

// ---- cassette -------------------------------------------------------------------------------
params.mhcmatch_cassette_k            = 20     // how many EPITOPES are selected. The construct
                                               // carries fewer: several can fall in one 27-mer
                                               // window, and the screen then withdraws some
params.mhcmatch_cassette_tol          = 0      // the size in [k-tol, k+tol] with the best
                                               // objective. A spent tolerance is a result
params.mhcmatch_cassette_score_column = null   // which column holds the aggregate. Left null the
                                               // rerank arm is given `<prefix>score` -- do NOT
                                               // leave that to the CLI fallback, because a
                                               // caller's table HAS a `score` column of its own
// **The essential-tissue / self-origin exclusion. `false` means NO safety check runs at all** --
// and a missing check that says nothing looks exactly like one that ran and found nothing, which
// is why MHCMATCH_CASSETTE announces the off state on every task.
params.mhcmatch_cassette_screen       = true
// The column holding the LONG (~27 aa) window, for a sample with no `windows` FASTA to pass as
// `--context`. No default on purpose: the CLI's own fallback is `peptide`, the MINIMAL epitope,
// which loads onto any cell without costimulation and is the TOLERISING configuration
// (PMID 17911588). With neither source the run STOPS and names the sample. `context_peptide` is
// the column in integrations/fixtures/.
params.mhcmatch_cassette_unit_column  = null
// Required by `cassette build` and unused by `order` (which the arms run): per-allotype capacity
// is not fitted by anything in the public record, so the value is yours to set.
params.mhcmatch_cassette_n0           = null

// **Two knobs, one CLI flag name, and they are different questions** -- which is why they are two
// params here and not one. `cassette select --block-live` is the HLA-LOSS rate (1.0 = nothing is
// ever lost); `cassette build/order --block-live` under `--quota` is P(a block is live) in the
// response model. Wiring the quota's 0.5 into the selector stops the run: a unit whose marginal p
// exceeds it is not representable, and one real donor had one at p = 0.7782.
params.mhcmatch_hla_loss              = 1.0
params.mhcmatch_quota_block_live      = 0.5
// Fill declared slot budgets so that at least k of each arm is expected to respond, rather than
// taking the ranked top. Off unless set: the arms and their targets are a trial-design decision
// with no defensible default.
params.mhcmatch_cassette_quota        = null
params.mhcmatch_cassette_evenness     = 0.0

// The cassette MAP: one row per unit, linker and predicted epitope in 1-based coordinates.
params.mhcmatch_cassette_map          = true
// **The two classes do not share a %rank cut-off**, which is why this is a TIER and not a number:
// NetMHCpan calls class I strong <= 0.5 / weak <= 2.0, NetMHCIIpan class II strong <= 2.0 / weak
// <= 10.0. `weak` is the default because the map reports and selects nothing.
params.mhcmatch_cassette_map_binder   = 'weak'
params.mhcmatch_cassette_map_threshold      = null
params.mhcmatch_cassette_map_threshold_mhc2 = null
// The ONE literal class-II panel a run may use for every sample -- the mouse case, and any cohort
// typed once. Answers when the donor's own class-II list is absent.
params.mhcmatch_cassette_map_alleles_mhc2   = null

// The responding fraction you expect of YOUR pool: a prior you own. It shifts every probability
// and moves no rank. Unset, the CLI uses TESLA's 37 of 615.
params.mhcmatch_prevalence                 = null
// Intra-cassette response correlation (CLI default 0.091, IVAC MUTANOME).
params.mhcmatch_cassette_rho               = null
// Fit one offset per donor instead of one over the run. Reports an ENRICHMENT against each donor's
// own background rather than a level, so no two donors' numbers are comparable. Choose deliberately.
params.mhcmatch_cassette_per_donor_offset  = false

// ---- pipeline.nf's own -----------------------------------------------------------------------
params.input        = params.input        ?: null   // the samplesheet CSV
params.mode         = params.mode         ?: 'both' // rerank | denovo | both
// One literal allele list for EVERY sample, bypassing MHCMATCH_ALLELES. Required for any sample
// whose samplesheet row names no `hla` file.
params.alleles      = params.alleles      ?: null
params.alleles_mhc2 = params.alleles_mhc2 ?: null

manifest {
    nextflowVersion = '>=22.10.0'
}
