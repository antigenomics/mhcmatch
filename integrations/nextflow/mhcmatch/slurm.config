// SLURM execution for the mhcmatch module. `includeConfig` this AFTER nextflow.config, or select
// it as `-profile slurm` from your pipeline's own profiles block:
//
//   profiles {
//       slurm { includeConfig 'integrations/nextflow/mhcmatch/slurm.config' }
//   }
//
// It sets the executor, sizes the five mhcmatch processes to what they actually consume, and --
// the part that is not boilerplate -- points every task at ONE shared reference and calibration
// directory. Without that a 200-sample run re-derives the same per-allele background 200 times and
// re-downloads the same reference sets 200 times, on nodes that may have no outbound network.

// ---------------------------------------------------------------- params, with defaults
//
// These are declared FIRST because `process.queue` and the `env` block below read them as plain
// assignments, which Groovy evaluates where they are written. Declared after their use they read
// back null, and the failure is silent: tasks go to the cluster default partition and every task
// reaches HuggingFace from a compute node instead of the staged mirror.

// `normal` is a common partition name, not a universal one -- Aldan-3 has short/medium/long/infinite
// and no `normal`, so this default gets every task rejected at submit there. Check `sinfo` and pass
// `--mhcmatch_slurm_queue`; also check its time limit, because MHCMATCH_CASSETTE asks for 8 h below
// and a 2 h queue cannot give it.
params.mhcmatch_slurm_queue        = 'normal'
// `projectDir` is a default that works for a laptop and is usually wrong for a cluster: it is
// wherever the pipeline was checked out, which is often a small, shared, untracked home quota. Point
// both at a large filesystem every compute node can see.
params.mhcmatch_pmhc_dir           = "${projectDir}/reference/pmhc_data"
params.mhcmatch_calibration_cache  = "${projectDir}/reference/calibration"
// The HuggingFace cache root. This is the one that decides where the ~250 MB of reference
// data physically lands, because `hf_hub_download` ignores MHCMATCH_PMHC_DIR when the file
// is not already staged there. Same default as the other two so one `--mhcmatch_*` triple
// moves the whole reference footprint onto a shared filesystem.
params.mhcmatch_hf_home            = "${projectDir}/reference/hf"

process {
    executor = 'slurm'
    queue    = params.mhcmatch_slurm_queue

    // Retry on the two exit codes a scheduler produces rather than the code does: 137 is the OOM
    // killer, 140 is a wall-clock kill. Both mean "same job, more of something", so both retry with
    // task.attempt scaling the request. Anything else is a real failure and is not retried.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Every selector is anchored loosely: `subworkflows/denovo.nf` includes the shared tail under a
    // `_DN` alias (a DSL2 process may be invoked once per run, and `--mode both` would otherwise
    // raise "Process 'X' has been already used"). A selector written as the exact name would size
    // the rerank arm and silently miss the de novo one -- which for MHCMATCH_CASSETTE means 8 GB
    // instead of 48 and an OOM kill hours in.
    withName: '.*MHCMATCH_PREDICT$' {
        cpus   = { 8  * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    // A table read and a lookup, and a coupling matrix over at most `cassette.MAX_POOL` = 2,000
    // rows. Both are seconds. Sized here rather than inheriting, because inheriting from a
    // neighbouring selector is how a 20-second job asks for 48 GB and sits behind quota for hours.
    // CASSETTE_SCORE belongs in this tier and had been in no tier at all: the `$` anchor on the
    // CASSETTE selector below excludes it, and the `process {}` defaults above set executor, queue
    // and retry but no cpus/memory/time -- so the one process with a history of never completing
    // was the one running on whatever the partition happened to default to. It earns the smallest
    // request honestly: measured on Aldan-3, a two-donor cohort scored in **under one second** on
    // **41 kB** of input, because it aggregates finished cassette tables and touches no panel.
    withName: '.*MHCMATCH_(ALLELES|CASSETTE_SELECT|CASSETTE_SCORE)(_DN)?$' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 20.m * task.attempt }
    }
    withName: '.*MHCMATCH_(RANK|RERANK)$' {
        // Same conditional shape as MHCMATCH_CASSETTE below, and for the same reason: `--extended`
        // /`--annotate` load the self-mimicry reference and the plain aggregate no longer does.
        // Without the branch this block silently overrides nextflow.config's sizing, because this
        // file is included AFTER it.
        cpus   = { 8  * task.attempt }
        memory = { "${params.mhcmatch_rank_extended}".toLowerCase() !in ['false', '0', 'no', ''] ? 24.GB * task.attempt : 8.GB * task.attempt }
        time   = { "${params.mhcmatch_rank_extended}".toLowerCase() !in ['false', '0', 'no', ''] ? 6.h  * task.attempt : 1.h * task.attempt }
    }
    withName: '.*MHCMATCH_(NEOAG|MIMICRY)(_DN)?$' {
        // Both are seqtree radius searches over a reference window set: one index build, then a
        // sweep. The index is the memory and it does not shrink with the number of peptides.
        cpus   = { 4  * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: '.*MHCMATCH_CASSETTE(_DN)?$' {
        // One whole-proteome index per register length when --screen is on: ~12 GB peak each, four
        // register lengths for class I. This is the one process whose request is not a guess.
        cpus   = { 4  * task.attempt }
        memory = { "${params.mhcmatch_vector_screen}".toLowerCase() !in ['false', '0', 'no', ''] ? 48.GB * task.attempt : 8.GB * task.attempt }
        time   = { "${params.mhcmatch_vector_screen}".toLowerCase() !in ['false', '0', 'no', ''] ? 8.h  * task.attempt : 1.h * task.attempt }
    }
}

// ---------------------------------------------------------------- the shared state

// Both directories MUST be on a filesystem every compute node can see, and both are shared by every
// task of every sample in the run.
//
//   MHCMATCH_PMHC_DIR            the reference mirror: ligand panel, thymic and viral sets, the
//                                tested-neoantigen deposits, the expression tables. Pre-stage it
//                                once with `mhcmatch bootstrap --reference` IN A JOB (`srun`), not
//                                on the login node -- it downloads and unpacks ~115 MB and login
//                                nodes are shared and often two-core. With it unset each task
//                                reaches for HuggingFace from a compute node instead.
//   MHCMATCH_CALIBRATION_CACHE   the per-allele %rank calibration. Deriving one allele's background
//                                is 0.15-3.4 s and every task that scores that allele pays it
//                                again; cached, a 25-allele panel goes 13.29 s -> 0.89 s.
//
// There is no third cache. `C_corpus` does not search -- it contracts a k-mer frequency table,
// which is the exact Luksza sum and costs a 64 KB artifact per reference deposit -- so there is no
// index to share. A fleet still carrying a `MHCMATCH_REFERENCE_CACHE` directory (~1 GB) can delete
// it.
//
// The cache is safe to share under concurrency by construction, which is why this is a plain shared
// directory and not a lock: an entry is written to a tempfile in the same directory and moved into
// place with os.replace, which is atomic on POSIX. A reader therefore sees either the old file, the
// new file, or no file -- never half of one. Two tasks racing on the same allele both compute it
// and both write it, and the payload is deterministic, so whichever lands last is the same bytes.
env {
    MHCMATCH_PMHC_DIR          = params.mhcmatch_pmhc_dir
    MHCMATCH_CALIBRATION_CACHE = params.mhcmatch_calibration_cache
    // `MHCMATCH_PMHC_DIR` is consulted first but is a READ override only: when a file is not
    // already staged there the fetch falls through to `hf_hub_download`, which writes to the
    // HuggingFace cache and never looks at this variable. Without HF_HOME every task on every
    // node re-downloads into ITS OWN $HOME -- the exact per-task re-download this block exists to
    // prevent, and on a cluster with a home quota it fills it.
    HF_HOME                    = params.mhcmatch_hf_home
    // Each task already has its own slurm CPU allocation; letting BLAS spawn a thread per core on
    // top of that oversubscribes the node and slows every task down.
    OMP_NUM_THREADS            = 1
    OPENBLAS_NUM_THREADS       = 1
    MKL_NUM_THREADS            = 1
}

executor {
    // Raise if your allocation allows it. This is per-run, not per-user.
    queueSize      = 100
    submitRateLimit = '20/1min'
}
